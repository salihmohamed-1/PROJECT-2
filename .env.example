# Snowflake Configuration
SNOWFLAKE_ACCOUNT=xy12345.us-east-1
SNOWFLAKE_USER=ATMOSYNC_USER
SNOWFLAKE_PASSWORD=YourSecurePassword123!
SNOWFLAKE_DATABASE=ATMOSYNC
SNOWFLAKE_SCHEMA=RAW
SNOWFLAKE_WAREHOUSE=ATMOSYNC_WH
SNOWFLAKE_ROLE=ATMOSYNC_ROLE

# Kafka Configuration
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC=container_telemetry
KAFKA_GROUP_ID=atmosync_loader_group

# Alerting Configuration
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/T00000000/B00000000/XXXXXXXXXXXXXXXXXXXXXXXX
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=alerts@atmosync.io
SMTP_PASSWORD=your_app_password
ALERT_EMAIL_FROM=alerts@atmosync.io
ALERT_EMAIL_TO=trader-ops@atmosync.io

# Pipeline Settings
SIMULATOR_CONTAINER_COUNT=20
SIMULATOR_INTERVAL_SECONDS=2
ARBITRAGE_ALERT_THRESHOLD=35000.0
